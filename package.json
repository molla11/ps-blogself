{
    "name": "ps-blogself",
    "displayName": "ps-blogself",
    "description": "Generate problem-solving blog from code evolution",
    "version": "0.0.1",
    "repository": {
        "type": "git",
        "url": "https://github.com/molla11/ps-blogself.git"
    },
    "engines": {
        "vscode": "^1.108.1",
        "node": ">=22"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onWebviewPanel:psb.blogPost"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "ps-blogself-container",
                    "title": "PS-Blogself",
                    "icon": "media/image/logo_ps_blogself1.png"
                }
            ]
        },
        "views": {
            "ps-blogself-container": [
                {
                    "type": "webview",
                    "id": "psb.sidebar",
                    "name": "PS-Blogself",
                    "icon": "media/image/logo_ps_blogself1.png"
                }
            ]
        },
        "commands": [
            {
                "command": "psb.connect",
                "title": "PS-Blogself: 로그인 / 계정"
            },
            {
                "command": "psb.sample",
                "title": "PS-Blogself: 샘플로 글 만들기"
            },
            {
                "command": "psb.openSettings",
                "title": "PS-Blogself: 설정",
                "icon": "$(gear)"
            },
            {
                "command": "psb.welcome",
                "title": "PS-Blogself: 시작하기 (Welcome)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "psb.openSettings",
                    "when": "view == psb.sidebar",
                    "group": "navigation@1"
                }
            ]
        },
        "configuration": {
            "title": "PS-Blogself",
            "properties": {
                "psb.prepareOnReview": {
                    "type": "boolean",
                    "default": true,
                    "scope": "window",
                    "description": "로그인한 상태에서 수정 이력을 열면 코드 변경을 AI 서비스로 보내 구간과 설명을 미리 준비합니다. 동일 이력은 재사용하며 AI 이용 횟수에 포함됩니다."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "pnpm run package",
        "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
        "watch": "pnpm run --parallel \"/^watch:.*/\"",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "test": "pnpm test:host",
        "test:unit": "node --test --require ./scripts/register-typescript.cjs src/test/storage.test.ts src/test/writing.test.ts src/test/writing-style.test.ts src/test/article-export.test.ts src/test/ghost.test.ts src/test/change-filter.test.ts src/test/input-limits.test.ts src/test/sidebar.test.ts src/test/multiwindow.test.ts src/test/connection-settings.test.ts src/test/recording-settings.test.ts src/test/usage.test.ts src/test/notices.test.ts src/test/service-jobs.test.ts src/test/welcome.test.ts",
        "test:ui": "playwright test",
        "dev": "pnpm check:backend && pnpm compile && node scripts/dev.cjs",
        "package:vsix": "vsce package --no-dependencies --allow-missing-repository --skip-license --out dist/ps-blogself.vsix",
        "test:host": "pnpm compile && node tests/vscode-host/launch.cjs",
        "check:backend": "node scripts/check-backend.cjs"
    },
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@types/markdown-it": "^14.1.2",
        "@types/node": "22.x",
        "@types/proper-lockfile": "^4.1.4",
        "@types/vscode": "^1.108.1",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "4.1.0",
        "cross-spawn": "7.0.6",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1"
    },
    "dependencies": {
        "@lexical/code-core": "0.53.0",
        "@lexical/extension": "0.53.0",
        "@lexical/history": "0.53.0",
        "@lexical/link": "0.53.0",
        "@lexical/list": "0.53.0",
        "@lexical/react": "0.53.0",
        "@lexical/rich-text": "0.53.0",
        "@lexical/selection": "0.53.0",
        "@lexical/table": "0.53.0",
        "@lexical/utils": "0.53.0",
        "@vscode/codicons": "^0.0.44",
        "diff": "^8.0.3",
        "lexical": "0.53.0",
        "markdown-it": "^14.1.0",
        "proper-lockfile": "^4.1.2",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "shiki": "^3.22.0"
    },
    "packageManager": "pnpm@11.5.1"
}
