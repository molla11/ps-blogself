# Development requires a running PS-Blogself backend.
# Copy to .env in this repository, then set the URL provided by the maintainer.
# The local backend must already be running at this address.
PSB_API_URL=http://127.0.0.1:4000/api

# F5 and pnpm dev read this file. Reload Window after changing it.
# This client has no standalone AI execution mode and accepts no AI provider key.
# .env is excluded from Git and the VSIX; installed extensions use the public service.
